# Copy to .env or .env.local in the repo root or backend directory for local use.
# Hosting/process environment variables take precedence over env files.
# Default local data directory is backend/var when PRESENCE_DATA_DIR is unset.
# PRESENCE_DATA_DIR=/data/presence
DATABASE_URL=
# With DATABASE_URL set, the web API defaults to download mode.
# PRESENCE_EXPORT_MODE=download
# PRESENCE_CV_THREADS=1
PRESENCE_BACKEND_KEY=
